# Public browser configuration, fixed when Vite builds the app.
# Never put AWS keys, database passwords or JWT secrets in VITE_ variables.

# false calls the actual API. true enables the labelled sample-data preview.
VITE_DEMO_MODE=false

# Includes /api. Use /api for same-origin hosting or the local Vite proxy.
# For a separate backend: https://api.example.com/api
VITE_API_BASE_URL=/api
