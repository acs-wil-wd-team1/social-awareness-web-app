NODE_ENV=development
PORT=3000

# Also used by docker-compose.yml to configure the local MySQL container
# and to create DB_NAME and DB_NAME_TEST on first boot. Keep DB_HOST as
# localhost — docker-compose maps the container's 3306 to the host's DB_PORT.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CauseConnect
DB_NAME_TEST=CauseConnect_test
DB_USER=root
DB_PASSWORD=DO_NOT_SHARE_YOUR_PASSWORD

JWT_SECRET=YOUR_JWT_SECRET